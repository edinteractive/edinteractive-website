# Cloudflare Pages response headers. Applied to every page and file.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com https://bookings.edinteractive.digital; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src 'self' https://cloudflareinsights.com; form-action 'self' https://*.zoho.com https://*.zohocloud.ca; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests

# Booking confirmation pages: Zoho opens them inside the booking widget on /book/ and /fr/reserver/
# after a booking, so they may be framed by this site only (booked.js then reloads them full-page).
/booked/*
  ! X-Frame-Options
  ! Content-Security-Policy
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com https://bookings.edinteractive.digital; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src 'self' https://cloudflareinsights.com; form-action 'self' https://*.zoho.com https://*.zohocloud.ca; frame-ancestors 'self'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests
/fr/reservation-confirmee/*
  ! X-Frame-Options
  ! Content-Security-Policy
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com https://bookings.edinteractive.digital; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src 'self' https://cloudflareinsights.com; form-action 'self' https://*.zoho.com https://*.zohocloud.ca; frame-ancestors 'self'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests

# Fonts and images rarely change: cache for a day, revalidate after.
/assets/fonts/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/assets/img/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
  Access-Control-Allow-Origin: *

# Scripts change with each deploy and import each other, so a stale copy mixed with a fresh one
# leaves the health check empty. Safari has been seen reusing old module copies despite
# must-revalidate, so scripts are never stored (they are small; styles still revalidate).
/assets/js/*
  Cache-Control: no-store
/assets/css/*
  Cache-Control: public, max-age=0, must-revalidate

# Keep preview and staging hosts out of search results.
https://:project.pages.dev/*
  X-Robots-Tag: noindex, nofollow
https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex, nofollow
