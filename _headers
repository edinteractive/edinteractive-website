# Cloudflare Pages response headers. Applied to every page and file.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src 'self' https://cloudflareinsights.com; form-action 'self' https://*.zoho.com https://*.zohocloud.ca; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests

# Fonts and images rarely change: cache for a day, revalidate after.
/assets/fonts/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/assets/img/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Scripts and styles change with each deploy and the scripts import each other, so a stale copy
# mixed with a fresh one breaks the page: always revalidate (cheap, Pages answers 304 via ETag).
/assets/js/*
  Cache-Control: public, max-age=0, must-revalidate
/assets/css/*
  Cache-Control: public, max-age=0, must-revalidate

# Keep preview and staging hosts out of search results.
https://:project.pages.dev/*
  X-Robots-Tag: noindex, nofollow
https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex, nofollow
